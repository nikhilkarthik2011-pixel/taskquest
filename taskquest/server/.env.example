PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Free hosted Postgres connection string, e.g. from https://neon.tech
# (Dashboard → your project → Connection string). Looks like:
# postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Forces the Dev Tools panel (jump levels, set streak, award badges, reset
# progress) on for EVERY account on this server. Leave this false — the easier,
# per-account way to turn it on is to create a list named "Manchester2023"
# with the 🏀 emoji while logged in (see README: "Turning on Dev Tools"). If
# you do set this true, it must also be true in web/.env (VITE_ENABLE_DEV_TOOLS)
# for the panel to actually show up.
ENABLE_DEV_TOOLS=false
