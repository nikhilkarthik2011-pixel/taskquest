VITE_API_URL=http://localhost:4000/api

# Forces the Dev Tools panel (jump levels, set streak, award badges, reset
# progress) on for every account. Leave this false — the easier, per-account
# way to turn it on is to create a list named "Manchester2023" with the 🏀
# emoji while logged in (see README: "Turning on Dev Tools"). If you do set
# this true, server/.env also needs ENABLE_DEV_TOOLS=true, since that's what
# actually protects the underlying routes.
VITE_ENABLE_DEV_TOOLS=false
